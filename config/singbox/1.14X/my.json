{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "dns": {
    "servers": [
      {"tag": "local", "type": "local", "prefer_go": true},
      {"tag": "ali", "type": "tcp", "server": "192.168.88.8", "detour": "直连"},
      {"tag": "tx", "type": "https", "server": "doh.pub", "domain_resolver": "hosts", "detour": "直连"},
      {"tag": "google", "type": "https", "server": "8.8.8.8", "detour": "默认代理"},
      {"tag": "fake-ip-dns-server", "type": "fakeip", "inet4_range": "198.19.0.0/16"},
      {"type": "hosts", "tag": "hosts", "predefined": {"doh.pub": ["223.5.5.5", "223.6.6.6"]}}
    ],
    "rules": [
      {"query_type": ["HTTPS", "SVCB"], "action": "reject"},
      {"rule_set": "geosite-category-ads-all","action": "reject"},
      {"clash_mode": "Direct", "server": "ali"},
      {"clash_mode": "Global", "server": "fake-ip-dns-server"},
      {"domain_suffix": ["liudl.top","cfs.kdns.fr","emcf.ccwu.cc","liudl.ccwu.cc","gh-proxy.com"], "server": "ali"},    
      {"rule_set": ["fakeipfilter-cn", "geosite-cn", "geosite-microsoft@cn", "geosite-apple@cn", "geosite-private"], "server": "ali"},
      {"rule_set": "fakeipfilter-!cn", "server": "google"},
      {"type": "logical", "mode": "and", "rules": [{"query_type": ["A", "AAAA"]}, {"rule_set": "geosite-geolocation-!cn", "invert": true}], "action": "evaluate", "server": "google", "timeout": "2s"},
      {"match_response": true, "rule_set": "geoip-cn", "server": "ali"},
      {"query_type": ["A", "AAAA"], "server": "fake-ip-dns-server", "rewrite_ttl": 1}
    ],
    "final": "google",
    "strategy": "prefer_ipv4", 
    "cache_capacity": 8192,
    "optimistic": {"enabled": true},
    "reverse_mapping": true
  },
"outbounds": [
    // 1. 先定义最底层的叶子节点组 (urltest 和手动选择)
    {"tag": "日本自动", "type": "urltest", "outbounds": [], "url": "https://clients1.google.com/generate_204", "interval": "5m", "tolerance": 50, "idle_timeout": "30m"},
    {"tag": "狮城自动", "type": "urltest", "outbounds": [], "url": "https://clients1.google.com/generate_204", "interval": "5m", "tolerance": 50, "idle_timeout": "30m"},
    {"tag": "香港自动", "type": "urltest", "outbounds": [], "url": "https://clients1.google.com/generate_204", "interval": "5m", "tolerance": 50, "idle_timeout": "30m"},
    {"tag": "美国自动", "type": "urltest", "outbounds": [], "url": "https://clients1.google.com/generate_204", "interval": "5m", "tolerance": 50, "idle_timeout": "30m"},
    {"tag": "英国自动", "type": "urltest", "outbounds": [], "url": "https://clients1.google.com/generate_204", "interval": "5m", "tolerance": 50, "idle_timeout": "30m"},
    {"tag": "手动选择", "type": "selector", "outbounds": []},
    {"tag": "自动选择", "type": "urltest", "outbounds": [], "url": "https://clients1.google.com/generate_204", "interval": "5m", "tolerance": 50, "idle_timeout": "30m"},
    {"tag": "延迟辅助", "type": "urltest", "outbounds": ["直连"], "url": "http://www.msftconnecttest.com/connecttest.txt", "interval": "5m", "idle_timeout": "30m"},
    {"tag": "直连", "type": "direct", "domain_resolver": "ali"},

    // 2. 再定义依赖上面测速组的中间业务分流组 (Selector)
    {"tag": "默认代理", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择"]},
    {"tag": "AI", "type": "selector", "outbounds": ["日本自动", "狮城自动", "美国自动", "英国自动", "手动选择", "自动选择"]},
    {"tag": "Twitter", "type": "selector", "outbounds": ["狮城自动", "香港自动", "美国自动", "手动选择", "自动选择"]},
    {"tag": "YouTube", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择"]},
    {"tag": "Google", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择"]},
    {"tag": "Github", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择"]},
    {"tag": "Telegram", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择"]},
    {"tag": "TikTok", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择"]},
    {"tag": "Netflix", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择"]},
    {"tag": "Wallet", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择"]},
    {"tag": "Steam", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择"]},
    {"tag": "Microsoft", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择", "直连"]},
    {"tag": "OneDrive", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择", "直连"]},
    {"tag": "Apple", "type": "selector", "outbounds": ["日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择", "直连"]},
    {"tag": "漏网之鱼", "type": "selector", "outbounds": ["默认代理", "日本自动", "狮城自动", "香港自动", "美国自动", "英国自动", "手动选择", "自动选择", "直连"]},

    // 3. 最后定义统领全局的总控制组
    {"tag": "GLOBAL", "type": "selector", "outbounds": ["默认代理", "AI", "YouTube", "Google", "Telegram", "Netflix", "漏网之鱼", "手动选择", "直连"]}
  ],
  "route": {
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "bypass"
      },
      {
        "domain_suffix": ["liudl.top","cfs.kdns.fr","ccwu.cc","gh-proxy.com"],
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-private",
        "action": "bypass"
      },
      {
        "rule_set": "geosite-cn",
        "action": "bypass"
      },
      {
        "rule_set": "geoip-cn",
        "action": "bypass"
      },
      {
        "type": "logical", 
        "mode": "or", 
        "rules": [{"domain_suffix": "push.apple.com"}, {"rule_set": "geoip-telegram"}], 
        "invert": true, 
        "action": "sniff", 
        "sniffer": ["http", "tls", "stun", "quic", "dns"], 
        "timeout": "100ms"
      },
      {"inbound": "dns-in", "action": "hijack-dns"},
      {"type": "logical", "mode": "or", "rules": [{"port": 853}, {"protocol": ["stun", "quic"]}], "action": "reject", "no_drop": true},
      {"network": "icmp", "action": "resolve"},
      {"network": "icmp", "outbound": "直连"},
      {"clash_mode": "Direct", "outbound": "直连"},
      {"clash_mode": "Global", "outbound": "GLOBAL"},
      {"rule_set": "geosite-category-ai-!cn", "outbound": "AI"},
      {"rule_set": "geosite-twitter", "outbound": "Twitter"},
      {"rule_set": "geosite-youtube", "outbound": "YouTube"},
      {"rule_set": "geosite-google", "outbound": "Google"},
      {"rule_set": "geosite-github", "outbound": "Github"},
      {"rule_set": "geosite-onedrive", "outbound": "OneDrive"},
      {"rule_set": "geosite-microsoft@cn", "outbound": "直连"},
      {"rule_set": "geosite-microsoft", "outbound": "Microsoft"},
      {"rule_set": "geosite-apple@cn", "outbound": "直连"},
      {"rule_set": "geosite-apple", "outbound": "Apple"},
      {"rule_set": "geosite-telegram", "outbound": "Telegram"},
      {"rule_set": "geosite-tiktok", "outbound": "TikTok"},
      {"rule_set": "geosite-netflix", "outbound": "Netflix"},
      {"rule_set": "geosite-paypal", "outbound": "Wallet"},
      {"rule_set": "geosite-binance", "outbound": "Wallet"},
      {"rule_set": "geosite-okx", "outbound": "Wallet"},
      {"rule_set": "geosite-category-cryptocurrency", "outbound": "Wallet"},
      {"rule_set": "geosite-steam@cn", "outbound": "直连"},
      {"rule_set": "geosite-steam", "outbound": "Steam"},
      {"rule_set": "geosite-geolocation-!cn", "outbound": "默认代理"},
      {"action": "resolve"},
      {"rule_set": "geoip-telegram", "outbound": "Telegram"}
    ],
    "rule_set": [
      {"tag": ["fakeipfilter-cn", "fakeipfilter-!cn"], "type": "remote", "format": "source", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/qichiyuhub/rule/refs/heads/main/rules/{tag}.json", "http_client": "代理下载"},
      {"tag": ["geosite-category-ai-!cn", "geosite-youtube", "geosite-google", "geosite-github", "geosite-onedrive", "geosite-microsoft", "geosite-microsoft@cn","geosite-apple", "geosite-apple@cn", "geosite-telegram", "geosite-tiktok", "geosite-netflix", "geosite-paypal", "geosite-binance", "geosite-okx", "geosite-category-cryptocurrency", "geosite-steam@cn", "geosite-steam", "geosite-geolocation-!cn", "geosite-cn", "geosite-private","geosite-twitter","geosite-category-ads-all"], "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs", "http_client": "代理下载"},
      {"tag": "geoip-telegram", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/telegram.srs", "http_client": "代理下载"},
      {"tag": "geoip-cn", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs", "http_client": "代理下载"}
    ],
    "final": "漏网之鱼",
    "default_http_client": "代理下载",
    "auto_detect_interface": true,
    "default_domain_resolver": {"server": "ali"}
  },
  "inbounds": [
    {
      "tag": "dns-in",
      "type": "direct",
      "listen": "::",
      "listen_port": 1053
    },
    {
      "tag": "http-in",
      "type": "http",
      "listen": "::",
      "listen_port": 8081  /* 已将冲突的 8080 更改为 8081 */
    },
    {
      "tag": "socks-in",
      "type": "socks",
      "listen": "::",
      "listen_port": 1080
    },
    {
      "tag": "tproxy-in",
      "type": "tproxy",
      "listen": "::",
      "listen_port": 7891
    },
    {
      "tag": "redirect-in",
      "type": "redirect",
      "listen": "::",
      "listen_port": 7890
    },
    {
      "tag": "tun-in",
      "type": "tun",
      "interface_name": "momo",
      "address": [
        "172.31.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true,
      "dns_mode": "hijack",
      "stack": "mixed",
      "auto_redirect": true
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "0.0.0.0",
      "listen_port": 9090,
      "secret": "passwd",
      "dashboard": {
        "enabled": true,
        "path": "/etc/sing-box/dashboard",
        "download_url": "https://gh-proxy.com/https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/etc/sing-box/cache.db",
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9095",
      "external_ui": "/etc/sing-box/ui",
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip",
      "secret": "passwd",
      "default_mode": "Rule"
    }
  },
  "certificate": {
    "store": "chrome"
  },
  "ntp": {
    "enabled": false  /* 关闭内置 NTP 校时，交由 OpenWrt 系统自身处理，避免网络初始化时的超时报错 */
  },
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  }
}
